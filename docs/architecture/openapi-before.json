          }
        },
        "type": "object",
        "required": [
          "application_id",
          "enterprise_id",
          "product_type",
          "requested_amount",
          "status",
          "account_manager_id",
          "account_manager_name",
          "submitted_at"
        ],
        "title": "Application",
        "description": "一笔申请只对应一种教学产品需求，金额单位为元。"
      },
      "ApplicationDetail": {
        "properties": {
          "application": {
            "$ref": "#/components/schemas/Application"
          },
          "enterprise": {
            "$ref": "#/components/schemas/Enterprise"
          },
          "status_history": {
            "items": {
              "$ref": "#/components/schemas/StatusEvent"
            },
            "type": "array",
            "title": "Status History"
          },
          "materials": {
            "items": {
              "$ref": "#/components/schemas/Material"
            },
            "type": "array",
            "title": "Materials"
          },
          "reports": {
            "items": {
              "$ref": "#/components/schemas/Report"
            },
            "type": "array",
            "title": "Reports"
          },
          "reviews": {
            "items": {
              "$ref": "#/components/schemas/ReviewRecord"
            },
            "type": "array",
            "title": "Reviews"
          }
        },
        "type": "object",
        "required": [
          "application",
          "enterprise",
          "status_history",
          "materials",
          "reports"
        ],
        "title": "ApplicationDetail",
        "description": "同一申请下的企业、材料和历次报告。"
      },
      "ApplicationSummary": {
        "properties": {
          "application_id": {
            "type": "string",
            "title": "Application Id"
          },
          "enterprise_id": {
            "type": "string",
            "title": "Enterprise Id"
          },
          "product_type": {
            "type": "string",
            "title": "Product Type"
          },
          "requested_amount": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Requested Amount"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "account_manager_id": {
            "type": "string",
            "title": "Account Manager Id"
          },
          "account_manager_name": {
            "type": "string",
            "title": "Account Manager Name"
          },
          "submitted_at": {
            "type": "string",
            "title": "Submitted At"
          },
          "enterprise_name": {
            "type": "string",
            "title": "Enterprise Name"
          },
          "report_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Report Status"
          }
        },
        "type": "object",
        "required": [
          "application_id",
          "enterprise_id",
          "product_type",
          "requested_amount",
          "status",
          "account_manager_id",
          "account_manager_name",
          "submitted_at",
          "enterprise_name",
          "report_status"
        ],
        "title": "ApplicationSummary"
      },
      "CheckRequest": {
        "properties": {
          "use_model": {
            "type": "boolean",
            "title": "Use Model",
            "default": false
          },
          "conditions": {
            "$ref": "#/components/schemas/Conditions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CheckRequest"
      },
      "Conditions": {
        "properties": {
          "uses_order_contract": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Fact"
              },
              {
                "type": "null"
              }
            ]
          },
          "is_used_equipment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Fact"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Conditions"
      },
      "Enterprise": {
        "properties": {
          "enterprise_id": {
            "type": "string",
            "title": "Enterprise Id"
          },
          "enterprise_name": {
            "type": "string",
            "title": "Enterprise Name"
          },
          "industry": {
            "type": "string",
            "title": "Industry"
          },
          "registered_region": {
            "type": "string",
            "title": "Registered Region"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "enterprise_id",
          "enterprise_name",
          "industry",
          "registered_region",
          "created_at"
        ],
        "title": "Enterprise"
      },
      "Evidence": {
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^S[1-6]$",
            "title": "Source Id"
          },
          "quote": {
            "type": "string",
            "maxLength": 1200,
            "minLength": 8,
            "title": "Quote"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "quote"
        ],
        "title": "Evidence"
      },
      "EvidenceRef": {
        "properties": {
          "material_id": {
            "type": "string",
            "title": "Material Id"
          },
          "file_name": {
            "type": "string",
            "title": "File Name"
          },
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "quote": {
            "type": "string",
            "title": "Quote"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "material_id",
          "file_name",
          "page",
          "quote"
        ],
        "title": "EvidenceRef"
      },
      "Fact": {
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "source": {
            "type": "string",
            "enum": [
              "manual_demo",
              "fixture",
              "application_field"
            ],
            "title": "Source"
          },
          "location": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Location"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "value",
          "source",
          "location"
        ],
        "title": "Fact"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ItemReview": {
        "properties": {
          "item_id": {
            "type": "string",
            "title": "Item Id"
          },
          "decision": {
            "type": "string",
            "enum": [
              "confirmed",
              "corrected"
            ],
            "title": "Decision"
          },
          "correction_note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
