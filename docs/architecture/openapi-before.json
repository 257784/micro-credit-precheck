          "enterprise_id": {
            "type": "string",
            "title": "Enterprise Id"
          },
          "product_type": {
            "type": "string",
            "title": "Product Type"
          },
          "requested_amount": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Requested Amount"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "account_manager_id": {
            "type": "string",
            "title": "Account Manager Id"
          },
          "account_manager_name": {
            "type": "string",
